#!/usr/bin/python3
"""Steel Shield: the app window.

A Norton/McAfee-style window over the steel-shield command, which keeps all
the protection logic: Status (logo, headline, one card per protection),
Scan (with real progress), Quarantine and History. Opened by `steel-shield`
when PySide6 is installed; otherwise steel-shield shows its kdialog menus.

Everything it changes goes through `steel-shield` subcommands and the
`steel-shield-system` helper (via pkexec), so the app and the command line
always agree.
"""
import html
import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

from PySide6.QtCore import QByteArray, QObject, QProcess, Qt, QTimer, Signal
from PySide6.QtGui import QFont, QIcon, QPainter, QPixmap
from PySide6.QtSvgWidgets import QSvgWidget
from PySide6.QtWidgets import (QAbstractItemView, QApplication, QFileDialog, QFrame, QGridLayout,
                               QHBoxLayout, QHeaderView, QLabel, QMainWindow, QMessageBox,
                               QProgressBar, QPushButton, QScrollArea, QSizePolicy,
                               QStackedWidget, QTableWidget, QTableWidgetItem, QVBoxLayout, QWidget)

# ---- Where things are ------------------------------------------------------
SHIELD = shutil.which("steel-shield") or "/usr/bin/steel-shield"
_here = Path(os.path.realpath(__file__)).parent
HELPER = next((str(p) for p in (_here / "steel-shield-system",
                                Path(SHIELD).resolve().parent.parent / "libexec" / "steel-shield-system",
                                Path("/usr/libexec/steel-shield-system")) if p.exists()),
              "/usr/libexec/steel-shield-system")
QUAR_HELPER = str(Path(HELPER).with_name("steel-shield-quarantine"))
HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "steel-shield"
QUAR = DATA / "quarantine"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "steel-shield"
LOG = STATE / "history.log"
SYSQ_INDEX = Path("/var/lib/steel-shield/quarantine.tsv")
DEMO = not Path(SHIELD).exists()   # no steel-shield here: show sample data (for screenshots)

BLUE, ORANGE = "#4A90D9", "#F2641E"

