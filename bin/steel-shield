#!/usr/bin/bash
# Steel Shield: lightweight, honest virus protection for Linux.
# https://github.com/steel-and-code/steel-shield
#
# The engine is ClamAV (clamscan), with definitions from Cisco Talos updated
# hourly by clamav-freshclam. clamscan runs only while it is scanning, then
# exits, so nothing sits in memory between scans. Every scan runs at the
# lowest CPU and disk priority.
#
#   steel-shield                    the dashboard
#   steel-shield scan PATH...       scan files or folders now (with a report)
#   steel-shield fullscan           scan the whole computer (asks for the password)
#   steel-shield watch-downloads    background: scan new files in Downloads
#   steel-shield usb-check          background: offer to scan new USB drives
#   steel-shield scan-usb MOUNT     scan one drive, risky files first
#   steel-shield weekly             background: scan the home folder
#   steel-shield restore ID         put a quarantined file back
#   steel-shield delete ID          delete a quarantined file for good
#   steel-shield allow ID           restore and never flag this file again
#   steel-shield status             one line per check, for scripts
#
# Detected files are moved to a quarantine folder, never deleted silently.

set -uo pipefail

APP="Steel Shield"
ICON=steel-shield
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/steel-shield"
QUAR="$DATA/quarantine"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/steel-shield"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steel-shield"
ALLOWED="$CONF/allowed-sha256"
LOG="$STATE/history.log"
DBDIR="${STEEL_SHIELD_DB:-/var/lib/clamav}"
# Definitions that ship with the system, used until the first download (and
# whenever they are newer). A scan never runs without definitions: it says so
# instead of reporting a clean result.
SEED=/usr/share/steel-shield/definitions
SYSQ_INDEX=/var/lib/steel-shield/quarantine.tsv
LIBEXEC="$(dirname "$(dirname "$(readlink -f "$0")")")/libexec"
SYSTEM_HELPER="$LIBEXEC/steel-shield-system"
# Restoring or deleting a file the full scan moved from outside the home folder
# is the one thing that still asks for the password.
QUAR_HELPER="$LIBEXEC/steel-shield-quarantine"
APP_WINDOW="$LIBEXEC/steel-shield-app"
DOWNLOADS="$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")"
mkdir -p "$QUAR" "$STATE" "$CONF"
chmod 0700 "$DATA" "$QUAR" 2>/dev/null || true
touch "$ALLOWED" "$LOG"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$*" >> "$LOG"; }

notify() { # notify urgency title body [action=label ...] -> prints chosen action
    local urgency="$1" title="$2" body="$3"; shift 3
    local args=(--app-name="$APP" --icon="$ICON" --urgency="$urgency")
    for a in "$@"; do args+=(--action="$a"); done
    [[ $# -gt 0 ]] && args+=(--wait)
    notify-send "${args[@]}" "$title" "$body" 2>/dev/null || true
}

# ---- Plain-English explanation of a ClamAV signature name -----------------
explain() {
    local sig="$1" lower platform kind
    lower="$(tr '[:upper:]' '[:lower:]' <<< "$sig")"
    if [[ "$lower" == *eicar* ]]; then
        echo "the harmless EICAR test file, used everywhere to check that virus protection works. It can't do any harm."
        return
    fi
    case "$lower" in
        behaviour.*)            platform="a program" ;;
        steelshield.extra.*)    platform="a file" ;;
        pua.*|*.pua.*)          platform="a program or file" ;;
        win.*|*win32*|*w32*)    platform="a Windows program" ;;
        unix.*|linux.*|elf.*)   platform="a Linux program" ;;
        osx.*|macos.*)          platform="a Mac program" ;;
        andr.*|android.*)       platform="an Android app" ;;
        doc.*|xls.*|ppt.*|*vba*) platform="an Office document" ;;
        pdf.*)                  platform="a PDF document" ;;
        html.*|js.*|php.*|*script*) platform="a web page or script" ;;
        email.*)                platform="an email" ;;
        *)                      platform="a file" ;;
    esac
    case "$lower" in
        *ransom*)               kind="that locks or scrambles your files and demands payment" ;;
        *phish*)                kind="made to trick you into giving away passwords or card details" ;;
        *keylog*|*spy*|*steal*|*infostealer*|*password*) kind="that steals passwords or watches what you type" ;;
        *backdoor*|*rat.*|*remote*) kind="that lets a stranger control the computer" ;;
        *coinminer*|*miner*)    kind="that secretly uses the computer to mine cryptocurrency" ;;
        *downloader*|*dropper*|*loader*) kind="that downloads more harmful software" ;;
        *worm*)                 kind="that spreads itself to other computers" ;;
        *exploit*|*cve*)        kind="that attacks a weakness in other software" ;;
        *adware*|pua.*|*.pua.*) kind="that is potentially unwanted: it shows ads or does things you probably didn't ask for" ;;
        *trojan*)               kind="that pretends to be something useful but harms the computer" ;;
        *)                      kind="that contains known harmful code" ;;
    esac
    local note=""
    [[ "$platform" == "a Windows program" ]] && note=" It can't run on Linux, but it could harm a Windows PC if copied there."
    echo "$platform $kind.$note"
}

# ---- Scanning ---------------------------------------------------------------
# Runs clamscan at the lowest priority on the given paths (or a file list with
# -f). Prints "path<TAB>signature" for each detection.
defs_dir() { # the folder of definitions to use, or nothing
    if [[ -n "${STEEL_SHIELD_DB:-}" ]]; then echo "$STEEL_SHIELD_DB"
    elif ls "$DBDIR"/main.c?d "$DBDIR"/daily.c?d >/dev/null 2>&1; then echo "$DBDIR"
    elif ls "$SEED"/main.c?d >/dev/null 2>&1; then echo "$SEED"; fi
}

run_clamscan() {
    local dir rc
    rm -f "$STATE/scan-error"
    dir="$(defs_dir)"
    if [[ -z "$dir" ]]; then
        echo "There are no virus definitions yet, so nothing could be checked." > "$STATE/scan-error"
        return 0
    fi
    # clamscan exits 1 when it finds something (a result) and 2 on an error.
    { nice -n 19 ionice -c 3 clamscan --no-summary --infected --stdout -d "$dir" "$@" 2>"$STATE/scan-stderr"
      rc=$?
      if [[ $rc -ge 2 ]] && grep -qiE 'no supported database|can.t open|malformed database|database.*error' "$STATE/scan-stderr"; then
          { echo "The virus definitions couldn't be loaded:"; head -3 "$STATE/scan-stderr"; } > "$STATE/scan-error"
      fi
      true; } \
        | sed -n 's/^\(.*\): \(.*\) FOUND$/\1\t\2/p'
}

is_allowed() {
    local sum
    sum="$(sha256sum "$1" 2>/dev/null | cut -d' ' -f1)" || return 1
    grep -qx "$sum" "$ALLOWED"
}

quarantine() { # quarantine path signature -> prints id
    local path="$1" sig="$2" id
    id="$(date +%Y%m%d-%H%M%S)-$RANDOM"
    mkdir -p "$QUAR/$id"
    if mv -f -- "$path" "$QUAR/$id/file"; then
        chmod 0400 "$QUAR/$id/file"
        printf 'path=%s\nsignature=%s\ndate=%s\nsha256=%s\n' "$path" "$sig" "$(date '+%Y-%m-%d %H:%M')" \
            "$(sha256sum "$QUAR/$id/file" | cut -d' ' -f1)" > "$QUAR/$id/info"
        log "QUARANTINED $path ($sig) as $id"
        echo "$id"
    else
        rmdir "$QUAR/$id" 2>/dev/null
        log "COULD NOT MOVE $path ($sig)"
        return 1
    fi
}

info_get() { sed -n "s/^$2=//p" "$QUAR/$1/info" 2>/dev/null | head -1; }

handle_detections() { # reads "path<TAB>sig" lines; quarantines and notifies
    local count=0 path sig id what
    while IFS=$'\t' read -r path sig; do
        [[ -n "$path" && -e "$path" ]] || continue
        if is_allowed "$path"; then log "ALLOWED (skipped) $path"; continue; fi
        id="$(quarantine "$path" "$sig")" || continue
        count=$((count + 1))
        what="$(explain "$sig")"
        (
            choice="$(notify critical "Threat removed: $(basename -- "$path")" \
                "It was $what It has been moved to quarantine. Nothing was deleted." \
                "restore=Restore" "details=Details")"
            case "$choice" in
                restore) "$0" restore "$id" ;;
                details) "$0" details "$id" ;;
            esac
        ) &
    done
    echo "$count" > "$STATE/last-found"
    return 0
}

record_scan() { # record_scan what
    date '+%Y-%m-%d %H:%M' > "$STATE/last-scan"
    echo "$1" > "$STATE/last-scan-what"
}

game_running() {
    pgrep -f 'steamapps/common|SteamLaunch|gamescope' >/dev/null 2>&1
}

# ---- Background jobs --------------------------------------------------------
watch_downloads() {
    mkdir -p "$DOWNLOADS"
    [[ -f "$CONF/downloads-off" ]] && { echo "Download scanning is off."; exit 0; }
    inotifywait -m -q -e close_write -e moved_to --format '%w%f' "$DOWNLOADS" | while true; do
        batch=()
        read -r first || exit 0
        batch+=("$first")
        # Gather whatever else lands in the next three seconds.
        while read -r -t 3 more; do batch+=("$more"); done
        files=()
        for f in "${batch[@]}"; do
            case "$f" in *.part|*.crdownload|*.tmp|*.download|*/.*) continue ;; esac
            [[ -f "$f" ]] && files+=("$f")
        done
        [[ ${#files[@]} -gt 0 ]] || continue
        run_clamscan "${files[@]}" | handle_detections
        record_scan "Downloads"
    done
}

usb_check() {
    local base="/run/media/$USER" seen="$STATE/seen-drives" mp
    touch "$seen"
    [[ -d "$base" ]] || exit 0
    for mp in "$base"/*; do
        [[ -d "$mp" ]] || continue
        grep -qxF "$mp" "$seen" && continue
        echo "$mp" >> "$seen"
        (
            choice="$(notify normal "Scan this drive?" \
                "$(basename -- "$mp") was plugged in. Steel Shield can check it for viruses, starting with programs and documents." \
                "scan=Scan" "later=Not now")"
            [[ "$choice" == scan ]] && "$0" scan-usb "$mp"
        ) &
    done
    # Forget drives that were removed, so they are offered again next time.
    while read -r mp; do [[ -d "$mp" ]] || sed -i "\|^$mp\$|d" "$seen"; done < <(cat "$seen")
}

scan_usb() {
    local mp="$1" risky rest found
    risky="$(mktemp)"; rest="$(mktemp)"
    find "$mp" -type f \( -iname '*.exe' -o -iname '*.msi' -o -iname '*.dll' -o -iname '*.scr' \
        -o -iname '*.bat' -o -iname '*.cmd' -o -iname '*.ps1' -o -iname '*.vbs' -o -iname '*.js' \
        -o -iname '*.lnk' -o -iname '*.zip' -o -iname '*.rar' -o -iname '*.7z' -o -iname '*.iso' \
        -o -iname '*.doc*' -o -iname '*.xls*' -o -iname '*.ppt*' -o -iname '*.pdf' -o -iname '*.sh' \
        -o -iname 'autorun.inf' \) 2>/dev/null > "$risky"
    find "$mp" -type f 2>/dev/null | grep -vxF -f "$risky" > "$rest" || true
    notify low "Scanning $(basename -- "$mp")" "Programs and documents first, then everything else."
    { run_clamscan -f "$risky"; run_clamscan -f "$rest"; } | handle_detections
    found="$(cat "$STATE/last-found" 2>/dev/null || echo 0)"
    record_scan "USB drive $(basename -- "$mp")"
    [[ "$found" == 0 ]] && notify low "$(basename -- "$mp") is clean" "No threats found."
    rm -f "$risky" "$rest"
}

weekly() {
    local tries=0
    while game_running; do
        tries=$((tries + 1)); [[ $tries -gt 12 ]] && { log "WEEKLY skipped: a game was running all afternoon"; exit 0; }
        sleep 1800
    done
    run_clamscan -r \
        --exclude-dir='/\.git$' --exclude-dir='/node_modules$' --exclude-dir='/\.cache$' \
        --exclude-dir='/\.local/share/Steam$' --exclude-dir='/\.var/app$' \
        --exclude-dir='/\.local/share/flatpak$' --exclude-dir='/\.local/share/steel-shield$' \
        --exclude-dir='/Games$' --exclude-dir='/\.local/share/containers$' \
        "$HOME" | handle_detections
    record_scan "Weekly scan of your home folder"
    log "WEEKLY scan finished, found $(cat "$STATE/last-found" 2>/dev/null || echo 0)"
}

# ---- Quarantine actions -----------------------------------------------------
restore() { # restore id [allow]
    local id="$1" path dest
    [[ -f "$QUAR/$id/file" ]] || { notify normal "Not found" "That item is no longer in quarantine."; return 1; }
    path="$(info_get "$id" path)"
    dest="$path"
    [[ -e "$dest" ]] && dest="${path%.*} (restored).${path##*.}"
    mkdir -p "$(dirname -- "$dest")"
    chmod 0600 "$QUAR/$id/file"
    mv -f -- "$QUAR/$id/file" "$dest"
    if [[ "${2:-}" == allow ]]; then
        info_get "$id" sha256 >> "$ALLOWED"
        log "ALLOWED $dest"
    fi
    rm -rf "${QUAR:?}/$id"
    log "RESTORED $dest"
    notify normal "File restored" "$(basename -- "$dest") is back in $(dirname -- "$dest")."
}

delete_item() {
    local id="$1"
    [[ -d "$QUAR/$id" ]] || return 1
    log "DELETED $(info_get "$id" path)"
    rm -rf "${QUAR:?}/$id"
}

details() {
    local id="$1" path sig
    path="$(info_get "$id" path)"; sig="$(info_get "$id" signature)"
    kdialog --title "$APP" --icon "$ICON" --yes-label "Keep it in quarantine" --no-label "Restore it" --yesno \
"<h3>$(basename -- "$path")</h3>
<p><b>What it is:</b> $(explain "$sig")</p>
<p><b>Where it was:</b> $(dirname -- "$path")</p>
<p><b>Found:</b> $(info_get "$id" date)</p>
<p><b>Why it was flagged:</b> it matches a known threat in the virus definitions.</p>
<p><b>What Steel Shield did:</b> moved it to quarantine, where it can't run. Nothing was deleted.</p>
<p><b>What to do:</b> nothing, if you didn't expect this file. If you trust it (for example a game mod or a tool you know), restore it.</p>
<p><small>Technical name: $sig</small></p>" || restore "$id"
}

# ---- Health and dashboard ---------------------------------------------------
defs_age_hours() {
    local newest dir
    dir="$(defs_dir)"
    [[ -n "$dir" ]] || { echo -1; return; }
    # When Cisco built the newest definitions, read from inside the file. The
    # file date can't be trusted: system images stamp files 1 January 1970.
    local built
    built="$(sigtool --info "$(ls "$dir"/daily.c?d 2>/dev/null | head -1)" 2>/dev/null | sed -n 's/^Build time: *//p' | head -1)"
    newest="$(date -d "$built" +%s 2>/dev/null)"
    [[ -n "$newest" ]] || newest="$(stat -c %Y "$dir"/daily.c?d "$dir"/main.c?d 2>/dev/null | sort -n | tail -1)"
    [[ -n "$newest" ]] || { echo -1; return; }
    echo $(( ($(date +%s) - newest) / 3600 ))
}

status_lines() { # prints "ok|warn<TAB>text<TAB>key" lines (the key is for the app)
    local age
    age="$(defs_age_hours)"
    if (( age < 0 )); then echo -e "warn\tThere are no virus definitions yet. Click Fix now.\tdefs"
    elif [[ "$(defs_dir)" == "$SEED" ]]; then
        if (( age > 7 * 24 )); then echo -e "warn\tUsing the built-in virus definitions, $((age / 24)) days old: online updates haven't arrived. Click Fix now.\tdefs"
        else echo -e "ok\tUsing the built-in virus definitions ($((age / 24)) days old) until the first online update.\tdefs"; fi
    elif (( age > 48 )); then echo -e "warn\tVirus definitions are $((age / 24)) days old. Click Fix now.\tdefs"
    else echo -e "ok\tVirus definitions are up to date (checked hourly).\tdefs"; fi
    if systemctl is-active --quiet clamav-freshclam.service; then echo -e "ok\tThe definitions updater is running.\tupdater"
    else echo -e "warn\tThe definitions updater isn't running.\tupdater"; fi
    if [[ -f "$CONF/downloads-off" ]]; then echo -e "warn\tDownload scanning is switched off.\tdownloads"
    elif systemctl --user is-active --quiet steel-shield-downloads.service; then echo -e "ok\tNew downloads are scanned automatically.\tdownloads"
    else echo -e "warn\tDownload scanning isn't running.\tdownloads"; fi
    if [[ -f "$STATE/last-scan" ]]; then echo -e "ok\tLast scan: $(cat "$STATE/last-scan-what" 2>/dev/null), $(cat "$STATE/last-scan").\tlastscan"
    else echo -e "ok\tNo scan has run yet.\tlastscan"; fi
    local n; n="$(find "$QUAR" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    echo -e "ok\tQuarantine: $n item(s).\tquarantine"
    # The computer's other protections, where this system has them.
    if systemctl is-active --quiet firewalld || { command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q 'Status: active'; }; then
        echo -e "ok\tFirewall is on.\tfirewall"
    else echo -e "warn\tFirewall is off.\tfirewall"; fi
    if [[ -e /run/ostree-booted ]]; then
        if rpm-ostree status --booted --json 2>/dev/null | grep -q 'ostree-image-signed'; then echo -e "ok\tSystem updates are signature-checked.\tsigned"
        else echo -e "warn\tSystem updates aren't signature-checked yet (restart after the next update).\tsigned"; fi
        echo -e "ok\tSystem files are read-only.\tsandbox"
    fi
    if mokutil --sb-state 2>/dev/null | grep -qi enabled; then echo -e "ok\tSecure Boot is on.\tsecureboot"; else echo -e "ok\tSecure Boot is off (optional).\tsecureboot"; fi
    # Behaviour watching.
    if [[ -f "$CONF/guard-off" ]]; then echo -e "warn\tBehaviour watching is switched off.\tguard"
    elif systemctl --user is-active --quiet steel-shield-guard.service; then
        echo -e "ok\tBehaviour watching is on: startup changes, file scrambling, hidden miners and newly runnable downloads.\tguard"
    else echo -e "warn\tBehaviour watching isn't running.\tguard"; fi
    local extra=/var/lib/clamav/steel-shield-extra.hsb
    if [[ -s "$extra" ]] && (( ($(date +%s) - $(stat -c %Y "$extra")) < 4 * 86400 )); then
        echo -e "ok\tThe extra list of new threats (abuse.ch) is up to date.\textra"
    fi
    if "$LIBEXEC/steel-shield-dns" status 2>/dev/null | grep -qx on; then
        echo -e "ok\tDangerous websites are blocked for every app (Quad9).\tweb"
    else echo -e "ok\tDangerous-website blocking is off (optional).\tweb"; fi
}

dashboard() {
    while true; do
        local lines warn=no text
        lines="$(status_lines)"
        grep -q '^warn' <<< "$lines" && warn=yes
        if [[ $warn == yes ]]; then text="<h2>Needs attention</h2>"; else text="<h2>You are protected</h2>"; fi
        while IFS=$'\t' read -r kind msg _; do
            if [[ $kind == ok ]]; then text+="&#10003; $msg<br>"; else text+="<b>&#9888; $msg</b><br>"; fi
        done <<< "$lines"
        local items=(scan "Quick scan (your files)" full "Full scan (the whole computer)" pick "Scan a file or folder" quarantine "Quarantine" history "History")
        [[ $warn == yes ]] && items=(fix "Fix now" "${items[@]}")
        if [[ -f "$CONF/downloads-off" ]]; then items+=(toggle "Turn download scanning on")
        else items+=(toggle "Turn download scanning off"); fi
        if [[ -f "$CONF/guard-off" ]]; then items+=(guard "Turn behaviour watching on")
        else items+=(guard "Turn behaviour watching off"); fi
        if "$LIBEXEC/steel-shield-dns" status 2>/dev/null | grep -qx on; then items+=(dns "Stop blocking dangerous websites")
        else items+=(dns "Block dangerous websites for every app"); fi
        choice="$(kdialog --title "$APP" --icon "$ICON" --geometry 560x520 --menu "$text" "${items[@]}")" || exit 0
        case "$choice" in
            fix) fix_now ;;
            full) full_scan ;;
            guard)
                if [[ -f "$CONF/guard-off" ]]; then
                    rm -f "$CONF/guard-off"; systemctl --user enable --now steel-shield-guard.service
                else
                    touch "$CONF/guard-off"; systemctl --user disable --now steel-shield-guard.service
                fi ;;
            dns)
                if "$LIBEXEC/steel-shield-dns" status 2>/dev/null | grep -qx on; then
                    pkexec "$LIBEXEC/steel-shield-dns" off
                elif kdialog --title "$APP" --icon "$ICON" --yesno \
"<h3>Block dangerous websites?</h3>
<p>Every app on this computer will look up websites through Quad9, a free, non-profit service that refuses to connect to known malware and phishing sites.</p>
<p>Quad9 doesn't keep your IP address. Turn it off here any time.</p>"; then
                    pkexec "$LIBEXEC/steel-shield-dns" on
                fi ;;
            scan) scan_with_report "$HOME" ;;
            pick)
                target="$(kdialog --title "$APP" --getexistingdirectory "$HOME")" || continue
                scan_with_report "$target" ;;
            quarantine) quarantine_view ;;
            history) kdialog --title "$APP" --icon "$ICON" --textbox "$LOG" 640 420 ;;
            toggle)
                if [[ -f "$CONF/downloads-off" ]]; then
                    rm -f "$CONF/downloads-off"; systemctl --user enable --now steel-shield-downloads.service
                else
                    touch "$CONF/downloads-off"; systemctl --user disable --now steel-shield-downloads.service
                fi ;;
        esac
    done
}

fix_now() {
    local out rc
    rm -f "$CONF/downloads-off" "$CONF/guard-off"
    systemctl --user restart steel-shield-downloads.service 2>/dev/null || true
    systemctl --user restart steel-shield-guard.service 2>/dev/null || true
    kdialog --title "$APP" --icon "$ICON" --passivepopup "Downloading the newest virus definitions ..." 8
    out="$(pkexec "$SYSTEM_HELPER" update 2>&1)"; rc=$?
    if [[ $rc -eq 126 ]]; then return; fi   # password window closed
    if [[ $rc -eq 3 ]]; then   # checked within the last hour (ClamAV asks not to check more often)
        kdialog --title "$APP" --icon "$ICON" --msgbox "<h3>Virus definitions are up to date</h3><p>Steel Shield checked for new ones $(sed -n 's/^already-checked [a-z]* /at /p' <<< "$out"), and checks again by itself every hour. To be fair to the free update service, it doesn't check more often than that.</p>"
        return
    fi
    if [[ $rc -eq 0 ]]; then
        kdialog --title "$APP" --icon "$ICON" --msgbox "<h3>Virus definitions are up to date</h3><p>Steel Shield checks for new ones every hour from now on.</p>"
    else
        kdialog --title "$APP" --icon "$ICON" --sorry "<h3>The virus definitions couldn't be updated</h3>
<p>Steel Shield keeps using the definitions it has, and tries again every 10 minutes. If this keeps happening, use <b>Report a Problem or Idea</b> in the start menu; these details help:</p>
<pre>$(sed 's/&/\&amp;/g; s/</\&lt;/g' <<< "$out" | tail -15)</pre>"
    fi
}

full_scan() {
    kdialog --title "$APP" --icon "$ICON" --yesno "<h3>Scan the whole computer?</h3>
<p>Every user's files, settings, downloads, programs you added and plugged-in drives. It can take an hour or more on a full disk; you can keep working, and you get a message when it's done.</p>
<p>The system itself is read-only and checked against its signature at every update, so it isn't scanned again.</p>" \
        --yes-label "Scan now" --no-label "Cancel" || return
    (
        local out rc found=0 sysfound=0 stuck=0 kind path sig id
        notify low "Full scan started" "Steel Shield is checking the whole computer. You can keep working."
        out="$(pkexec "$SYSTEM_HELPER" fullscan 2>/dev/null)"; rc=$?
        if [[ $rc -eq 126 || $rc -eq 127 ]]; then exit 0; fi
        if [[ $rc -eq 2 ]] || grep -q '^error' <<< "$out"; then
            notify critical "The full scan couldn't run" "There are no virus definitions yet. Open Steel Shield and click Fix now."
            exit 0
        fi
        printf '%s\n' "$out" | awk -F'\t' '$1 == "user" {print $2 "\t" $3}' | handle_detections
        found="$(cat "$STATE/last-found" 2>/dev/null || echo 0)"
        sysfound="$(grep -c '^system' <<< "$out")"
        stuck="$(grep -c '^stuck' <<< "$out")"
        while IFS=$'\t' read -r kind path sig id; do
            [[ "$kind" == system ]] && log "QUARANTINED (system) $path ($sig) as $id"
        done <<< "$out"
        record_scan "Full scan of the whole computer"
        local total=$((found + sysfound))
        if [[ $total -eq 0 && $stuck -eq 0 ]]; then
            notify normal "Full scan: no threats found" "The whole computer was checked."
        else
            notify critical "Full scan: $total threat(s) moved to quarantine" \
                "Open Steel Shield, Quarantine, to see what they are or restore one.$([[ $stuck -gt 0 ]] && echo " $stuck file(s) couldn't be moved; see History.")"
            grep '^stuck' <<< "$out" | while IFS=$'\t' read -r kind path sig; do log "COULD NOT MOVE $path ($sig)"; done
        fi
    ) &
}

scan_with_report() {
    local found
    kdialog --title "$APP" --icon "$ICON" --passivepopup "Scanning $1 ... this can take a while." 5
    run_clamscan -r --exclude-dir='/\.local/share/steel-shield$' --exclude-dir='/\.local/share/Steam$' "$@" | handle_detections
    if [[ -s "$STATE/scan-error" ]]; then
        kdialog --title "$APP" --icon "$ICON" --sorry "<h3>The scan couldn't run</h3><p>$(cat "$STATE/scan-error")</p><p>Open Steel Shield and click <b>Fix now</b>.</p>"
        return
    fi
    record_scan "$*"
    found="$(cat "$STATE/last-found" 2>/dev/null || echo 0)"
    if [[ "$found" == 0 ]]; then
        kdialog --title "$APP" --icon "$ICON" --msgbox "<h3>No threats found</h3><p>Scanned: $*</p>"
    else
        kdialog --title "$APP" --icon "$ICON" --msgbox "<h3>$found threat(s) moved to quarantine</h3><p>Open Quarantine in Steel Shield to see what they are, or to restore one.</p>"
    fi
}

quarantine_view() {
    local items=() id
    for d in "$QUAR"/*/; do
        [[ -f "$d/info" ]] || continue
        id="$(basename "$d")"
        items+=("$id" "$(basename -- "$(info_get "$id" path)") ($(info_get "$id" date))")
    done
    if [[ -s "$SYSQ_INDEX" ]]; then
        local sid spath ssig sdate
        while IFS=$'\t' read -r sid spath ssig sdate; do
            [[ -n "$sid" ]] && items+=("sys:$sid" "$(basename -- "$spath") ($sdate, from $(dirname -- "$spath"))")
        done < "$SYSQ_INDEX"
    fi
    if [[ ${#items[@]} -eq 0 ]]; then
        kdialog --title "$APP" --icon "$ICON" --msgbox "Quarantine is empty."
        return
    fi
    id="$(kdialog --title "Quarantine" --icon "$ICON" --menu "Pick an item to see what it is, restore it or delete it." "${items[@]}")" || return
    if [[ "$id" == sys:* ]]; then system_item "${id#sys:}"; return; fi
    action="$(kdialog --title "Quarantine" --icon "$ICON" --menu "$(explain "$(info_get "$id" signature)")" \
        details "Details" restore "Restore it" allow "Restore it and always allow this file" delete "Delete it for good")" || return
    case "$action" in
        details) details "$id" ;;
        restore) restore "$id" ;;
        allow) restore "$id" allow ;;
        delete)
            kdialog --title "Quarantine" --warningyesno "Delete $(basename -- "$(info_get "$id" path)") for good? This can't be undone." \
                && delete_item "$id" ;;
    esac
}

system_item() { # an item the full scan moved from outside the home folder
    local sid="$1" spath ssig action dest
    spath="$(awk -F'\t' -v i="$sid" '$1 == i {print $2}' "$SYSQ_INDEX")"
    ssig="$(awk -F'\t' -v i="$sid" '$1 == i {print $3}' "$SYSQ_INDEX")"
    action="$(kdialog --title "Quarantine" --icon "$ICON" --menu "<b>$(basename -- "$spath")</b> from $(dirname -- "$spath"): $(explain "$ssig")" \
        restore "Restore it (asks for your password)" delete "Delete it for good (asks for your password)")" || return
    case "$action" in
        restore)
            dest="$(pkexec "$QUAR_HELPER" restore "$sid" 2>/dev/null)" && {
                log "RESTORED (system) $dest"; notify normal "File restored" "$(basename -- "$dest") is back in $(dirname -- "$dest")."; } ;;
        delete)
            kdialog --title "Quarantine" --warningyesno "Delete $(basename -- "$spath") for good? This can't be undone." \
                && pkexec "$QUAR_HELPER" delete "$sid" && log "DELETED (system) $spath" ;;
    esac
}

set_switch() { # set downloads|guard|web on|off
    case "$1:$2" in
        downloads:on) rm -f "$CONF/downloads-off"; systemctl --user enable --now steel-shield-downloads.service ;;
        downloads:off) touch "$CONF/downloads-off"; systemctl --user disable --now steel-shield-downloads.service ;;
        guard:on) rm -f "$CONF/guard-off"; systemctl --user enable --now steel-shield-guard.service ;;
        guard:off) touch "$CONF/guard-off"; systemctl --user disable --now steel-shield-guard.service ;;
        web:on|web:off) pkexec "$LIBEXEC/steel-shield-dns" "$2" ;;
        firewall:on|firewall:off) # asks for the password: it changes the whole computer
            if command -v firewall-cmd >/dev/null 2>&1; then
                if [[ "$2" == on ]]; then pkexec systemctl enable --now firewalld.service
                else pkexec systemctl disable --now firewalld.service; fi
            elif command -v ufw >/dev/null 2>&1; then
                if [[ "$2" == on ]]; then pkexec ufw enable; else pkexec ufw disable; fi
            else return 1; fi ;;
        *) echo "usage: steel-shield set downloads|guard|web|firewall on|off" >&2; return 2 ;;
    esac
    log "SETTING $1 turned $2"
}

# The app window (steel-shield-app) when Qt for Python is installed; the
# kdialog menus otherwise.
open_dashboard() {
    if [[ -x "$APP_WINDOW" && -z "${STEEL_SHIELD_MENUS:-}" ]] && python3 -c 'import PySide6.QtSvgWidgets' 2>/dev/null; then
        exec "$APP_WINDOW"
    fi
    dashboard
}

case "${1:-dashboard}" in
    dashboard) open_dashboard ;;
    menus) dashboard ;;
    defs-dir) d="$(defs_dir)"; [[ -n "$d" ]] && echo "$d" ;;
    set) set_switch "${2:-}" "${3:-}" ;;
    log) shift; log "$*" ;;
    record-scan) shift; record_scan "$*" ;;
    fullscan) full_scan; wait ;;
    scan) shift; scan_with_report "$@" ;;
    watch-downloads) watch_downloads ;;
    usb-check) usb_check ;;
    scan-usb) scan_usb "$2" ;;
    weekly) weekly ;;
    restore) restore "$2" ;;
    allow) restore "$2" allow ;;
    delete) delete_item "$2" ;;
    details) details "$2" ;;
    status) status_lines ;;
    explain) explain "$2" ;;
    quarantine-file) # behaviour watcher: quarantine a stopped program (path signature)
        [[ -f "$2" ]] && printf '%s\t%s\n' "$2" "${3:-Behaviour.Suspicious}" | handle_detections ;;
    quarantine-scan) # behaviour watcher: scan one file now, quarantine if it is a known threat
        run_clamscan "$2" | handle_detections; record_scan "$(basename -- "$2")" ;;
    selftest-scan) # used by the image build: scan, quarantine, restore without a desktop
        shift
        run_clamscan "$@" | while IFS=$'\t' read -r p s; do quarantine "$p" "$s"; done ;;
    *) echo "usage: steel-shield [dashboard|scan PATH...|restore ID|delete ID|status]" >&2; exit 2 ;;
esac
